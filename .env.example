# Copy to .env.local and replace placeholders.

# Solana cluster: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Dedicated RPC (Helius, QuickNode, Triton, etc.)
NEXT_PUBLIC_RPC_URL=https://your-helius-or-quicknode-rpc

# Platform fee destination (base58 pubkey). Placeholder = fee step skipped.
NEXT_PUBLIC_FEE_WALLET=YourActualFeeWalletPubkeyHere

# Optional: Pinata gateway hostname (default gateway.pinata.cloud)
# NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud

# Site URL for metadata / OG (production)
# NEXT_PUBLIC_SITE_URL=https://solana.rootrecord.info

# Server-only: Pinata JWT for /api/pin/* (never expose to the browser)
PINATA_JWT=your_pinata_jwt_from_pinata_cloud

# Optional fee amounts (SOL)
# NEXT_PUBLIC_CREATE_FEE_SOL=0.025
# NEXT_PUBLIC_ACTION_FEE_SOL=0.01
